generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model rooms {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_code     String           @unique
  room_type     String
  monthly_price Decimal          @db.Decimal(12, 2)
  floor         String
  created_at    DateTime         @default(dbgenerated("(now() AT TIME ZONE 'Asia/Bangkok'::text)")) @db.Timestamp(6)
  updated_at    DateTime         @default(dbgenerated("(now() AT TIME ZONE 'Asia/Bangkok'::text)")) @db.Timestamp(6)
  status_room   enum_status_room @default(dbgenerated("ว่าง (พร้อมเข้าพัก)"))
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model rooms_rate {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rate      BigInt
  room_type enum_room_type
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tenants {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name  String
  email      String   @unique
  phone      String?
  status     String   @default("")
  created_at DateTime @default(dbgenerated("(now() AT TIME ZONE 'Asia/Bangkok'::text)")) @db.Timestamp(6)
  updated_at DateTime @default(dbgenerated("(now() AT TIME ZONE 'Asia/Bangkok'::text)")) @db.Timestamp(6)
}

enum enum_room_type {
  STUDIO      @map("สตูดิโอ")
  ONE_BEDROOM @map("1 ห้องนอน")
  TWO_BEDROOM @map("2 ห้องนอน")
}

/// This enum is commented in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
enum enum_status_room {
  VACANT      @map("ว่าง (พร้อมเข้าพัก)")
  MAINTENANCE @map("อยู่ระหว่างซ่อมบำรุง")
  OCCUPIED    @map("มีผู้เช่า")
}
